# ============================================================
# 配置模板 —— 复制为 .env 后填写，切勿把真实值提交到 git 或发送到对话
# ============================================================

# 阿里百炼 DashScope API Key（在百炼控制台生成，仅自己填写到本地 .env）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# DeepSeek 模型（默认 V4 Pro，非思考模式）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=deepseek-v4-pro

# GitHub Token（可选：公开 API 配额不足时再配置，同样自行填写）
# GITHUB_TOKEN=

# 被墙源开关（Reddit / Meta / Microsoft / Google blog / xAI）
# 若本地有代理，设为 true 并填写代理地址；httpx 会自动走代理
# ENABLE_BLOCKED_SOURCES=true
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# 每日更新时刻（默认 08:00）
UPDATE_HOUR=8
UPDATE_MINUTE=0

# SQLite 数据库路径
DATABASE_URL=sqlite:///data/news.db

# 飞书自建应用推送（留空则不推送）
# 在飞书开放平台（open.feishu.cn）创建"企业自建应用"后，于「凭证与基础信息」页获取 App ID 与 App Secret；
# 用户 open_id 需通过飞书 OpenAPI（如 通讯录/用户 接口）按自己手机号或邮箱查询得到。
# FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# FEISHU_USER_OPEN_ID=ou_xxxxxxxxxxxxxxxx
